  "scripts": {
    "ng": "ng",
    "upgrade": "ng update --all",
    "build": "ng build --configuration=dev",
    "build-devstaging": "ng build --configuration=devstaging",
    "build-devbeta": "ng build --configuration=devbeta",
    "build-staging": "ng build --configuration=staging",
    "build-beta": "ng build --configuration=beta",
    "build-prod": "ng build --configuration=prod",
    "start": "node --max_old_space_size=8192 node_modules/@angular/cli/bin/ng serve --host 0.0.0.0 --port 4200 --configuration=dev",
    "start-staging": "node --max_old_space_size=8192 node_modules/@angular/cli/bin/ng serve --host 0.0.0.0 --poll 1000 --port 4200 --configuration=devstaging",
    "start-beta": "ng serve --host 0.0.0.0 --poll 1000 --port 4200 --configuration=devbeta",
    "debug": "ng serve --host 0.0.0.0 --port 4200 --configuration=dev --source-map=true",
    "debug-staging": "ng serve --host 0.0.0.0 --port 4200 --configuration=devstaging --source-map=true",
    "test": "ng test",
    "pree2e": "webdriver-manager update --standalone false --gecko false",
    "e2e": "protractor",
    "bundle-report": "node --max_old_space_size=8192 node_modules/@angular/cli/bin/ng build --configuration=prod --stats-json && npm run stats",
    "stats": "webpack-bundle-analyzer dist/stats.json --port 9200"
